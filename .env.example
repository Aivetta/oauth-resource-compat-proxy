PORT=8787
HOST=0.0.0.0

# Public URL where Claude reaches this proxy.
PUBLIC_BASE_URL=https://your-proxy.example.com

# Canonical MCP path/resource exposed to Claude.
MCP_PATH=/mcp

# Microsoft Entra tenant authority, including /v2.0.
UPSTREAM_AUTH_BASE_URL=https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0

# What Claude/public metadata may use.
PUBLIC_MCP_RESOURCE=https://your-proxy.example.com/mcp
PUBLIC_SCOPE=mcp.access

# What Entra is actually configured to accept.
AUDIENCE_RESOURCE=https://your-proxy.example.com/mcp
UPSTREAM_SCOPE=https://your-proxy.example.com/mcp/mcp.access

# Set true if your Entra flow works better without RFC 8707 resource at all.
STRIP_RESOURCE=false
